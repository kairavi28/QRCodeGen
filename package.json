{
  "name": "qrcodegen-biomed",
  "version": "1.0.0",
  "description": "QR Code Generator for Biomedical Waste Management",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd qrcode-generator && PORT=3000 npm start",
    "build": "cd qrcode-generator && npm run build",
    "install-all": "npm install && cd qrcode-generator && npm install"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.18.2",
    "mongoose": "^8.9.5"
  }
}
